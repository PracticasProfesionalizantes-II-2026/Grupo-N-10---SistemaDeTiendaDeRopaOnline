@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    ViewData["Title"] = "Panel Administrador";
    var usuarioLogueado = Context.Session.GetString("UsuarioSesion");
    var nombreUsuario = !string.IsNullOrEmpty(usuarioLogueado) ? usuarioLogueado.Split('@')[0].ToUpper() : "ADMIN";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F&R - Panel de Administración</title>
    
    <!-- FAVICON & ESTILOS -->
    <link rel="icon" type="image/png" href="~/images/logo-fr.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #000000;
        }

        /* HEADER */
        .admin-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e9ecef;
            padding: 16px 40px;
        }

        .header-title {
            font-size: 0.95rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #333333;
        }

        /* CONTAINER AMPLIO */
        .main-container {
            max-width: 1320px;
            padding-top: 50px;
            padding-bottom: 60px;
        }

        /* TARJETAS DEL MENÚ MÁS GRANDES */
        .menu-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            padding: 45px 20px;
            text-align: center;
            text-decoration: none;
            color: #000000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 6px rgba(0,0,0,0.01);
        }

        .menu-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.06);
            color: #000000;
            border-color: #cbd5e1;
        }

        .icon-circle {
            width: 65px;
            height: 65px;
            background-color: #111827;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 20px;
        }

        .card-label {
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

        /* TARJETA CERRAR SESIÓN MÁS ANCHA */
        .logout-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #fee2e2;
            padding: 30px 20px;
            text-align: center;
            text-decoration: none;
            color: #dc2626;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease-in-out;
            width: 100%;
        }

        .logout-card:hover {
            background-color: #fef2f2;
            color: #dc2626;
            border-color: #fca5a5;
        }

        .icon-logout-circle {
            width: 50px;
            height: 50px;
            background-color: #ef4444;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->
    <header class="admin-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-fr.png" alt="F&R Logo" style="height: 32px; width: auto;" />
            </a>
            <span class="header-title border-start ps-3">PANEL ADMINISTRADOR</span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="small fw-bold text-uppercase" style="font-size: 0.8rem;">HOLA, @nombreUsuario</span>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold" style="font-size: 0.78rem;">
                Volver a la Tienda
            </a>
        </div>
    </header>

    <!-- ========================================================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================================================= -->
    <div class="container main-container">
        
        <div class="text-center mb-5">
            <h1 class="fw-black text-uppercase tracking-wide" style="font-weight: 900; font-size: 2.3rem;">CUENTA ADMINISTRADOR</h1>
            <p class="text-muted small">Seleccione una opción para gestionar la plataforma</p>
        </div>

        <!-- GRILLA DE OPCIONES EN 4 COLUMNAS -->
        <div class="row g-4 mb-4">
            
            <!-- 1. GESTIÓN DE PRODUCTOS -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="Productos" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <span class="card-label">GESTIÓN DE PRODUCTOS</span>
                </a>
            </div>

            <!-- 2. GESTIÓN DE PEDIDOS -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="Pedidos" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-truck"></i>
                    </div>
                    <span class="card-label">GESTIÓN DE PEDIDOS</span>
                </a>
            </div>

            <!-- 3. GESTIÓN DE CLIENTES -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="Clientes" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-people"></i>
                    </div>
                    <span class="card-label">GESTIÓN DE CLIENTES</span>
                </a>
            </div>

            <!-- 4. GESTIÓN DE EMPLEADOS -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="Empleados" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <span class="card-label">GESTIÓN DE EMPLEADOS</span>
                </a>
            </div>

            <!-- 5. CONFIGURAR TIENDA -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="ConfigurarTienda" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-gear"></i>
                    </div>
                    <span class="card-label">CONFIGURAR TIENDA</span>
                </a>
            </div>

            <!-- 6. HISTORIAL FACTURAS -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="Facturas" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <span class="card-label">HISTORIAL FACTURAS</span>
                </a>
            </div>

            <!-- 7. REPORTES DE VENTA -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Administrador" asp-action="Reportes" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <span class="card-label">REPORTES DE VENTA</span>
                </a>
            </div>

            <!-- 8. CAMBIAR CONTRASEÑA -->
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Account" asp-action="CambiarContrasena" class="menu-card">
                    <div class="icon-circle">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <span class="card-label">CAMBIAR CONTRASEÑA</span>
                </a>
            </div>

        </div>

        <!-- BOTÓN CERRAR SESIÓN -->
        <div class="row justify-content-center mt-4">
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="Account" asp-action="Logout" class="logout-card">
                    <div class="icon-logout-circle">
                        <i class="bi bi-box-arrow-right"></i>
                    </div>
                    <span class="card-label fw-bold">CERRAR SESIÓN</span>
                </a>
            </div>
        </div>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>