@model IEnumerable<FRFront.Models.ItemCarrito>

@{
    ViewData["Title"] = "CARRITO";
    decimal totalGeneral = Model?.Sum(x => x.Total) ?? 0;
}

<div class="container my-5">
    
    <!-- ENCABEZADO Y VOLVER -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark fw-bold small">&lt; VOLVER</a>
        <h3 class="fw-bold text-uppercase mb-0" style="letter-spacing: 2px;">CARRITO</h3>
        <div style="width: 70px;"></div>
    </div>

    <div class="card border-0 shadow-sm p-4">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr class="text-uppercase small text-muted border-bottom">
                            <th scope="col">Producto</th>
                            <th scope="col" class="text-center">Precio</th>
                            <th scope="col" class="text-center">Cantidad</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col" class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light p-2 rounded" style="width: 70px; height: 70px;">
                                            <img src="@Url.Content(item.Imagen)" alt="@item.Nombre" class="img-fluid h-100 object-fit-cover">
                                        </div>
                                        <span class="fw-bold text-dark small">@item.Nombre</span>
                                    </div>
                                </td>
                                <td class="text-center fw-semibold">$@item.Precio.ToString("N0")</td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center border rounded px-2 py-1">
                                        <span class="fw-bold px-2">@item.Cantidad</span>
                                    </div>
                                </td>
                                <td class="text-end fw-bold">$@item.Total.ToString("N0")</td>
                                <td class="text-end">
                                    <!-- Botón eliminar ítem (opcional) -->
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TOTALES Y BOTÓN FINALIZAR -->
            <div class="d-flex flex-column align-items-end mt-4 pt-3 border-top">
                <h4 class="fw-bold mb-3">Total General: $@totalGeneral.ToString("N0")</h4>
                
                <div class="d-flex gap-3 align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">Seguir comprando</a>
                    
                    <!-- Al hacer clic acá, el controlador evalúa si está logueado -->
                    <a asp-controller="Carrito" asp-action="FinalizarCompra" class="btn btn-primary text-uppercase fw-bold px-4 py-2" style="background-color: #3b6ef3; border: none;">
                        FINALIZAR COMPRA
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted fs-5">Tu carrito está vacío.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-dark text-uppercase fw-bold mt-2">Ver Productos</a>
            </div>
        }
    </div>
</div>