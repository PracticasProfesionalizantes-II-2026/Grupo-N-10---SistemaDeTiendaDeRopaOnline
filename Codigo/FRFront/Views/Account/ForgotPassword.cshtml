@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<!-- FontAwesome para iconos -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<style>
    :root {
        --primary-color: #2b5876;
        --secondary-color: #4e4376;
    }
    .recovery-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        background: #ffffff;
    }
    .btn-custom-primary {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 28px;
        font-weight: 600;
        width: 100%;
    }
    .btn-custom-primary:hover {
        color: white;
        opacity: 0.95;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            
            <!-- Botón Volver (Redirige al Login) -->
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted fw-bold mb-3 d-inline-block">
                <i class="fa-solid fa-arrow-left me-1"></i> VOLVER AL LOGIN
            </a>

            <div class="card recovery-card p-4 p-md-5">
                
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="fa-solid fa-lock-open fa-3x" style="color: var(--primary-color);"></i>
                    </div>
                    <h4 class="fw-bold text-uppercase">Mi Cuenta de Administrador</h4>
                    <p class="text-muted small mt-2">
                        ¿Perdiste tu contraseña? Por favor, ingresá tu nombre de usuario o correo electrónico. Recibirás un enlace para crear una contraseña nueva por correo electrónico.
                    </p>
                </div>

                <!-- Alert de Error -->
                <div id="errorAlert" class="alert alert-danger d-none" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    <span id="errorMessage">Debe completar los campos requeridos *</span>
                </div>

                <!-- Alert de Éxito -->
                <div id="successAlert" class="alert alert-success d-none" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    Se ha enviado un enlace de recuperación a tu correo electrónico.
                </div>

                <form id="recoveryForm" novalidate>
                    <div class="mb-4">
                        <label for="userOrEmail" class="form-label text-muted small fw-bold">
                            Nombre de usuario o correo electrónico <span class="text-danger">*</span>
                        </label>
                        <input 
                            type="text" 
                            class="form-control form-control-lg" 
                            id="userOrEmail" 
                            placeholder="Nombre de usuario o correo electrónico" 
                        >
                    </div>

                    <button type="submit" class="btn btn-custom-primary text-uppercase">
                        <i class="fa-solid fa-paper-plane me-2"></i>Enviar
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const form = document.getElementById('recoveryForm');
    const input = document.getElementById('userOrEmail');
    const errorAlert = document.getElementById('errorAlert');
    const errorMessage = document.getElementById('errorMessage');
    const successAlert = document.getElementById('successAlert');

    // Usuarios de prueba registrados
    const usuariosValidos = ["Rocio", "rociomilanese01@gmail.com", "admin"];

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = input.value.trim();

        errorAlert.classList.add('d-none');
        successAlert.classList.add('d-none');
        input.classList.remove('is-invalid');

        // Validar si el campo está vacío
        if (val === '') {
            errorMessage.textContent = 'Debe completar los campos requeridos *';
            errorAlert.classList.remove('d-none');
            input.classList.add('is-invalid');
            return;
        }

        // Validar si el usuario existe en la lista
        if (!usuariosValidos.includes(val)) {
            errorMessage.textContent = 'Usuario no encontrado';
            errorAlert.classList.remove('d-none');
            input.classList.add('is-invalid');
            return;
        }

        // Respuesta correcta
        successAlert.classList.remove('d-none');
        input.value = '';
    });
</script>
}