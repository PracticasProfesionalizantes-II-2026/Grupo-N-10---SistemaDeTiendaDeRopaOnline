@model FRFront.Models.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>F&R - Recuperar Contraseña</title>
  
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

  <style>
    body {
      background-color: #f1f3f5;
    }

    .login-card {
      width: 100%;
      max-width: 800px;
      background-color: #ffffff;
      border-radius: 28px;
      border: 1px solid #e9ecef;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
      padding: 50px 60px;
    }
    
    .custom-input {
      padding: 18px 24px !important;
      font-size: 1.15rem !important;
      border-radius: 50px !important;
      border: 2px solid #212529 !important;
      background-color: #ffffff !important;
    }

    .custom-btn {
      padding: 18px !important;
      font-size: 1.2rem !important;
      border-radius: 50px !important;
      background-color: #000000 !important;
      border: none !important;
    }

    .custom-title {
      font-size: 2.5rem !important;
      letter-spacing: 2px;
      font-weight: 900 !important;
    }
  </style>
</head>
<body class="min-vh-100 d-flex align-items-center justify-content-center py-5">

  <div class="login-card">
    
    <!-- Botón Volver al Login -->
    <div class="mb-4">
      <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-dark fw-bold fs-5">
        &lt; VOLVER
      </a>
    </div>

    <!-- Título -->
    <div class="text-center mb-4">
      <h1 class="custom-title text-uppercase text-dark">RECUPERAR CONTRASEÑA</h1>
      <p class="text-secondary fs-6 mt-2">Ingresa tu correo electrónico para enviarte un enlace de restablecimiento.</p>
    </div>

    <!-- Mensaje de Éxito si viene del Controller -->
    @if (ViewBag.MensajeExito != null)
    {
        <div class="alert alert-success text-center border-0 rounded-4 p-3 mb-4 fs-6">
            @ViewBag.MensajeExito
        </div>
    }

    <!-- Formulario -->
    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="w-100">
      
      <div class="mb-4">
        <input asp-for="Email" type="email" class="form-control custom-input text-center" placeholder="Correo electrónico*" required />
        <span asp-validation-for="Email" class="text-danger small text-center d-block mt-1"></span>
      </div>

      <button type="submit" class="btn btn-dark w-100 custom-btn text-uppercase fw-bold text-white mb-3">
        ENVIAR ENLACE
      </button>

    </form>

  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>