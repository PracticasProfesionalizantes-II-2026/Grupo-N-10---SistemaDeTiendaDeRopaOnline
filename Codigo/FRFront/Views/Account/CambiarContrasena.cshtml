@model FRFront.Models.CambiarContrasenaViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recuperar contraseña";
}
<div class="container py-5" style="max-width: 650px;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-3 fw-semibold" role="alert">@TempData["SuccessMessage"]</div>
    }
    <div class="card border-0 shadow-sm p-4 p-md-5">
        <h1 class="h4 fw-bold text-uppercase mb-2">RECUPERAR CONTRASEÑA</h1>
        <p class="text-muted mb-4">Ingresá tu correo electrónico y te enviaremos las instrucciones para recuperar el acceso.</p>
        <form asp-controller="Account" asp-action="CambiarContrasena" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small fw-semibold mb-3"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-bold text-uppercase small"></label>
                <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="tu-correo@ejemplo.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-dark w-100 fw-bold text-uppercase">Recuperar contraseña</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
