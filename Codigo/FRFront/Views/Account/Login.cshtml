@model FRFront.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>F&R - Iniciar Sesión</title>
  
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

  <style>
    body {
      background-color: #f1f3f5;
    }

    .login-card {
      width: 100%;
      max-width: 800px;
      background-color: #ffffff;
      border-radius: 28px;
      border: 1px solid #e9ecef;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
      padding: 50px 60px;
    }
    
    .custom-input {
      padding: 18px 24px !important;
      font-size: 1.15rem !important;
      border-radius: 50px !important;
      border: 2px solid #212529 !important;
      background-color: #ffffff !important;
    }

    .custom-input:focus {
      box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.15) !important;
    }

    .custom-btn {
      padding: 18px !important;
      font-size: 1.2rem !important;
      border-radius: 50px !important;
      background-color: #000000 !important;
      border: none !important;
      transition: all 0.2s ease-in-out;
    }

    .custom-btn:hover {
      background-color: #212529 !important;
      transform: translateY(-1px);
    }

    .custom-title {
      font-size: 2.8rem !important;
      letter-spacing: 2px;
      font-weight: 900 !important;
    }
  </style>
</head>
<body class="min-vh-100 d-flex align-items-center justify-content-center py-5">

  <div class="login-card">
    
    <!-- Enlace Volver -->
    <div class="mb-4">
      <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark fw-bold fs-5">
        &lt; VOLVER
      </a>
    </div>

    <!-- Título -->
    <div class="text-center mb-5">
      <h1 class="custom-title text-uppercase text-dark">INICIAR SESIÓN</h1>
    </div>

    <!-- Formulario -->
    <form asp-controller="Account" asp-action="Login" method="post" class="w-100">
      
      <div class="mb-4">
        <input asp-for="Email" type="email" class="form-control custom-input text-center" placeholder="Correo electrónico o usuario*" required />
        <span asp-validation-for="Email" class="text-danger small text-center d-block mt-1"></span>
      </div>

      <div class="mb-3">
        <input asp-for="Password" type="password" class="form-control custom-input text-center" placeholder="Contraseña*" required />
        <span asp-validation-for="Password" class="text-danger small text-center d-block mt-1"></span>
      </div>

      <div class="text-center mb-5">
        <a asp-controller="Account" asp-action="ForgotPassword" class="text-secondary text-decoration-none fs-6 fw-semibold">
          ¿Olvidaste tu contraseña?
        </a>
      </div>

      <button type="submit" class="btn btn-dark w-100 custom-btn text-uppercase fw-bold text-white mb-4">
        ACCEDER
      </button>

      <div class="text-center mt-3">
        <a asp-controller="Account" asp-action="Register" class="text-dark text-decoration-none fw-bold fs-5">
          Crear cuenta
        </a>
      </div>

    </form>

  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
  <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>