@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>F&R - Contraseña Guardada</title>
  
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light min-vh-100 d-flex align-items-center justify-content-center py-5">

  <!-- Se aumentó el max-width a 600px para mayor amplitud -->
  <div class="container" style="max-width: 600px;">
    <div class="card shadow-lg border-0 p-5 position-relative rounded-4">
      
      <!-- Marca F&R en la esquina superior derecha -->
      <div class="position-absolute top-0 end-0 p-4 fw-bold text-dark fs-5 tracking-wider">
        F&R
      </div>

      <!-- Botón Volver -->
      <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-bold fs-6">
          &lt; VOLVER
        </a>
      </div>

      <!-- Título principal más grande -->
      <div class="text-center mb-4">
        <h2 class="h4 fw-bold text-uppercase text-secondary tracking-wide mb-1">
          CREAR NUEVA CONTRASEÑA EMPLEADO
        </h2>
      </div>

      <!-- Alerta de Éxito Ampliada -->
      <div class="text-center my-4 py-4 px-3 bg-success-subtle rounded-4 border border-success-subtle">
        <div class="mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill text-success" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
          </svg>
        </div>
        <h3 class="h5 fw-bold text-success text-uppercase mb-0">
          ¡CONTRASEÑA GUARDADA CON ÉXITO!
        </h3>
      </div>

      <!-- Botón de acción más grande (py-3) -->
      <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark w-100 text-uppercase fw-bold py-3 fs-6 rounded-3 shadow">
          INICIAR SESIÓN
        </a>
      </div>

    </div>
  </div>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>