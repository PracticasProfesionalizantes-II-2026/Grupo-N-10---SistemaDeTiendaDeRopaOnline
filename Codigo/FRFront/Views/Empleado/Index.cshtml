@{
    Layout = null;
    ViewData["Title"] = "Panel de Cajero";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F&R - Cuenta Cajero</title>
    
    <link rel="icon" type="image/png" href="~/images/logo-fr.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        /* Estilo de fila idéntico al panel de Administrador */
        .module-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e9ecef;
            padding: 20px 30px;
            transition: all 0.25s ease;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            margin-bottom: 16px;
        }

        .module-card:hover {
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            border-color: #ced4da;
        }

        .btn-black-pill {
            background-color: #000;
            color: #fff;
            border-radius: 50px;
            padding: 10px 24px;
            font-weight: 800;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: none;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease;
            text-align: center;
        }

        .btn-black-pill:hover {
            background-color: #212529;
            color: #fff;
        }
        
        .btn-outline-pill {
            background-color: transparent;
            color: #000;
            border: 2px solid #000;
            border-radius: 50px;
            padding: 8px 24px;
            font-weight: 800;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease;
            text-align: center;
        }

        .btn-outline-pill:hover {
            background-color: #000;
            color: #fff;
        }

        .icon-container {
            width: 42px;
            height: 42px;
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #212529;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-fr.png" alt="F&R Logo" style="height: 45px; width: auto;" />
            </a>
            <span class="fs-5 fw-bold text-dark border-start ps-3 py-1">CUENTA CAJERO</span>
        </div>

        <div>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-pill fw-bold px-4 py-2" style="font-size: 0.82rem;">
                CERRAR SESIÓN
            </a>
        </div>
    </header>

    <div class="container py-5" style="max-width: 1000px;">

        <!-- TÍTULO ESTILO ADMINISTRADOR -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="fw-black text-uppercase mb-1" style="font-weight: 900;">PANEL DE CAJERO</h1>
                <p class="text-muted mb-0">Gestión de operaciones y ventas del turno actual</p>
            </div>
            <div>
                <span class="badge bg-dark text-white rounded-pill px-4 py-2 fw-bold" style="font-size: 0.85rem; letter-spacing: 1px;">
                    TURNO ACTIVO
                </span>
            </div>
        </div>

        <!-- LISTADO DE OPCIONES EN FILAS -->
        <div class="d-flex flex-column">

            <!-- NUEVA VENTA -->
            <div class="module-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start">
                        <div class="icon-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0 fw-bold text-uppercase fs-6">
                        NUEVA VENTA
                    </div>
                    <div class="col-12 col-md-5 mb-3 mb-md-0 text-muted small">
                        Registra ventas presenciales, selecciona prendas e inicia cobros.
                    </div>
                    <div class="col-12 col-md-3 text-end d-flex justify-content-center justify-content-md-end">
                        <button class="btn-black-pill w-100" onclick="alert('Iniciando nueva venta...');">INGRESAR A VENTA</button>
                    </div>
                </div>
            </div>

            <!-- GESTIÓN DE PEDIDOS -->
            <div class="module-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start">
                        <div class="icon-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0 fw-bold text-uppercase fs-6">
                        GESTIÓN DE PEDIDOS
                    </div>
                    <div class="col-12 col-md-5 mb-3 mb-md-0 text-muted small">
                        Consulta pedidos realizados online pendientes de entrega.
                    </div>
                    <div class="col-12 col-md-3 text-end d-flex justify-content-center justify-content-md-end">
                        <button class="btn-black-pill w-100" onclick="alert('Cargando gestión de pedidos...');">VER PEDIDOS</button>
                    </div>
                </div>
            </div>

            <!-- GESTIÓN DE CLIENTES -->
            <div class="module-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start">
                        <div class="icon-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0 fw-bold text-uppercase fs-6">
                        GESTIÓN DE CLIENTES
                    </div>
                    <div class="col-12 col-md-5 mb-3 mb-md-0 text-muted small">
                        Busca clientes registrados o crea nuevos perfiles de comprador.
                    </div>
                    <div class="col-12 col-md-3 text-end d-flex justify-content-center justify-content-md-end">
                        <a asp-controller="Clientes" asp-action="Index" class="btn-black-pill w-100">VER CLIENTES</a>
                    </div>
                </div>
            </div>

            <!-- HISTORIAL FACTURAS -->
            <div class="module-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start">
                        <div class="icon-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0 fw-bold text-uppercase fs-6">
                        HISTORIAL FACTURAS
                    </div>
                    <div class="col-12 col-md-5 mb-3 mb-md-0 text-muted small">
                        Revisa comprobantes emitidos o reimprime facturas pasadas.
                    </div>
                    <div class="col-12 col-md-3 text-end d-flex justify-content-center justify-content-md-end">
                        <a asp-controller="Facturas" asp-action="Index" class="btn-black-pill w-100">VER FACTURAS</a>
                    </div>
                </div>
            </div>

            <!-- GESTIÓN DE PRODUCTOS -->
            <div class="module-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start">
                        <div class="icon-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0 fw-bold text-uppercase fs-6">
                        GESTIÓN DE PRODUCTOS
                    </div>
                    <div class="col-12 col-md-5 mb-3 mb-md-0 text-muted small">
                        Consulta el catálogo, stock disponible y precios de lista.
                    </div>
                    <div class="col-12 col-md-3 text-end d-flex justify-content-center justify-content-md-end">
                        <button class="btn-black-pill w-100" onclick="alert('Cargando catálogo de productos...');">VER PRODUCTOS</button>
                    </div>
                </div>
            </div>

            <!-- CONTRASEÑA -->
            <div class="module-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 d-flex justify-content-center justify-content-md-start">
                        <div class="icon-container">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </div>
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0 fw-bold text-uppercase fs-6">
                        SEGURIDAD
                    </div>
                    <div class="col-12 col-md-5 mb-3 mb-md-0 text-muted small">
                        Cambia tu clave de acceso o gestiona tus credenciales.
                    </div>
                    <div class="col-12 col-md-3 text-end d-flex justify-content-center justify-content-md-end">
                        <a asp-controller="Account" asp-action="CambiarContrasena" class="btn-outline-pill w-100">CAMBIAR CLAVE</a>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>