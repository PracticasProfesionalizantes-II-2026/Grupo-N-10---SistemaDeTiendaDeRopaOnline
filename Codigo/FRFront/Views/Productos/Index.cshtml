@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    ViewData["Title"] = "Gestión de Productos";
    var usuarioLogueado = Context.Session.GetString("UsuarioSesion");
    var nombreUsuario = !string.IsNullOrEmpty(usuarioLogueado) ? usuarioLogueado.Split('@')[0] : "Administrador";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F&R - Gestión de Productos</title>
    
    <link rel="icon" type="image/png" href="~/images/logo-fr.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
        }

        .filter-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e9ecef;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }

        .product-item-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e9ecef;
            padding: 15px 20px;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }

        .product-item-card:hover {
            box-shadow: 0 8px 16px rgba(0,0,0,0.06);
            border-color: #ced4da;
        }

        .product-img {
            width: 70px;
            height: 85px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #f1f3f5;
        }

        .color-badge {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: inline-block;
            border: 1px solid #ccc;
            vertical-align: middle;
            margin-right: 5px;
        }

        .form-select-custom, .form-control-custom {
            border-radius: 50px;
            padding: 10px 20px;
            border: 1px solid #ced4da;
            font-weight: 500;
        }

        .form-select-custom:focus, .form-control-custom:focus {
            border-color: #212529;
            box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.15);
        }

        .btn-add-product {
            background-color: #000;
            color: #fff;
            border-radius: 50px;
            padding: 10px 24px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-add-product:hover {
            background-color: #212529;
            color: #fff;
            transform: translateY(-2px);
        }

        .action-btn {
            background: transparent;
            border: none;
            color: #6c757d;
            padding: 6px 10px;
            border-radius: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .action-btn:hover {
            background-color: #f1f3f5;
            color: #212529;
        }

        .action-btn-danger:hover {
            background-color: #fee2e2;
            color: #dc3545;
        }

        .table-header-custom {
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 1px;
            color: #6c757d;
            text-transform: uppercase;
            padding: 0 20px 10px 20px;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-fr.png" alt="F&R Logo" style="height: 50px; width: auto;" />
            </a>
            <span class="fs-5 fw-bold text-muted border-start ps-3 py-1">GESTIÓN DE PRODUCTOS</span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Administrador" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3">
                &lt; Volver al Panel
            </a>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="container py-5">
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h1 class="fw-bolder tracking-wider mb-1">PRODUCTOS</h1>
                <p class="text-muted mb-0">Administra el catálogo de la tienda, stock y precios</p>
            </div>
            <div>
                <a asp-controller="Producto" asp-action="Crear" class="btn-add-product d-inline-flex align-items-center gap-2 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-plus-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M8.5 4.5a.5.5 0 0 0-1 0v3h-3a.5.5 0 0 0 0 1h3v3a.5.5 0 0 0 1 0v-3h3a.5.5 0 0 0 0-1h-3z"/>
                    </svg>
                    Agregar Nuevo Producto
                </a>
            </div>
        </div>

        <!-- FILTROS Y BÚSQUEDA -->
        <div class="filter-card mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold small text-muted mb-1">FILTRAR POR CATEGORÍA:</label>
                    <select class="form-select form-select-custom">
                        <option value="">Todas las categorías</option>
                        <option value="mujer">Mujer</option>
                        <option value="hombre">Hombre</option>
                        <option value="remeras">Remeras</option>
                        <option value="pantalones">Pantalones</option>
                        <option value="abrigos">Abrigos</option>
                        <option value="polleras">Polleras</option>
                        <option value="vestidos">Vestidos</option>
                    </select>
                </div>
                <div class="col-12 col-md-8">
                    <label class="form-label fw-bold small text-muted mb-1">BUSCAR PRODUCTO:</label>
                    <div class="input-group">
                        <input type="text" class="form-control form-control-custom" placeholder="Buscar por nombre, código o talle..." />
                        <button class="btn btn-dark rounded-pill px-4 ms-2 fw-bold" type="button">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ENCABEZADOS -->
        <div class="row table-header-custom d-none d-md-flex align-items-center">
            <div class="col-md-1 text-center">SELEC.</div>
            <div class="col-md-1">IMAGEN</div>
            <div class="col-md-3">NOMBRE</div>
            <div class="col-md-2 text-center">PRECIO</div>
            <div class="col-md-1 text-center">TALLE</div>
            <div class="col-md-2 text-center">COLOR</div>
            <div class="col-md-1 text-center">STOCK</div>
            <div class="col-md-1 text-end">ACCIONES</div>
        </div>

        <!-- LISTA DE PRODUCTOS -->
        <div class="d-flex flex-column gap-3">
            
            <!-- PRODUCTO 1 -->
            <div class="product-item-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <input type="checkbox" class="form-check-input" style="width: 20px; height: 20px; cursor: pointer;" checked />
                    </div>
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <img src="~/images/hombres.png" alt="Buzo VCV" class="product-img" />
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0">
                        <h6 class="fw-bold text-uppercase mb-0">BUZO VCV</h6>
                        <small class="text-muted">Cod: #PROD-001</small>
                    </div>
                    <div class="col-12 col-md-2 mb-2 mb-md-0 text-center">
                        <span class="fw-bold text-dark fs-6">$80.000,00</span>
                    </div>
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <span class="badge bg-light text-dark border fw-bold">M / L</span>
                    </div>
                    <div class="col-12 col-md-2 mb-2 mb-md-0 text-center">
                        <span class="color-badge" style="background-color: #f5f5dc;"></span>
                        <span class="small fw-bold text-uppercase">BEIGE</span>
                    </div>
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2">10 u.</span>
                    </div>
                    <div class="col-12 col-md-1 text-end d-flex justify-content-center justify-content-md-end gap-1">
                        <a asp-controller="Producto" asp-action="Modificar" asp-route-id="1" class="action-btn" title="Modificar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5h6a.5.5 0 0 0 0-1h-6A1.5 1.5 0 0 0 1 2.5z"/>
                            </svg>
                        </a>
                        <button class="action-btn action-btn-danger" title="Eliminar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- PRODUCTO 2 -->
            <div class="product-item-card">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <input type="checkbox" class="form-check-input" style="width: 20px; height: 20px; cursor: pointer;" />
                    </div>
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <img src="~/images/mujeres.png" alt="Remera Active" class="product-img" />
                    </div>
                    <div class="col-12 col-md-3 mb-2 mb-md-0">
                        <h6 class="fw-bold text-uppercase mb-0">REMERA ACTIVE</h6>
                        <small class="text-muted">Cod: #PROD-002</small>
                    </div>
                    <div class="col-12 col-md-2 mb-2 mb-md-0 text-center">
                        <span class="fw-bold text-dark fs-6">$20.000,00</span>
                    </div>
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <span class="badge bg-light text-dark border fw-bold">XS / S / M</span>
                    </div>
                    <div class="col-12 col-md-2 mb-2 mb-md-0 text-center">
                        <span class="color-badge" style="background-color: #000000;"></span>
                        <span class="small fw-bold text-uppercase">NEGRO</span>
                    </div>
                    <div class="col-12 col-md-1 mb-2 mb-md-0 text-center">
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2">14 u.</span>
                    </div>
                    <div class="col-12 col-md-1 text-end d-flex justify-content-center justify-content-md-end gap-1">
                        <a asp-controller="Producto" asp-action="Modificar" asp-route-id="2" class="action-btn" title="Modificar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5h6a.5.5 0 0 0 0-1h-6A1.5 1.5 0 0 0 1 2.5z"/>
                            </svg>
                        </a>
                        <button class="action-btn action-btn-danger" title="Eliminar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-trash3" viewBox="0 0 16 16">
                                <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- MODAL POPUP: PRODUCTO ELIMINADO -->
    <div class="modal fade" id="modalEliminado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-body text-center p-5">
                    <div class="mb-3 text-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                            <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l.853 10.66A2 2 0 0 1 11.815 16H4.185a2 2 0 0 1-1.995-1.84L1.338 3.5H.8a.5.5 0 0 1 0-1H4.3V1.5A1.5 1.5 0 0 1 5.8 0h4.4a1.5 1.5 0 0 1 1.5 1.5"/>
                        </svg>
                    </div>
                    <h3 class="fw-bold text-uppercase mb-2">PRODUCTO ELIMINADO</h3>
                    <p class="text-muted mb-4">El producto seleccionado ha sido removido del sistema.</p>
                    <button type="button" class="btn btn-dark rounded-pill fw-bold px-4 py-2 text-uppercase" data-bs-dismiss="modal">
                        &lt; VOLVER
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // SIMULACIÓN DE ELIMINACIÓN EN BOTONES CON ÍCONO DE PAPELERA
        document.querySelectorAll('.action-btn-danger').forEach(btn => {
            btn.addEventListener('click', function () {
                var modal = new bootstrap.Modal(document.getElementById('modalEliminado'));
                modal.show();
            });
        });
    </script>
</body>
</html>