@{
    string? rolSesion = Context.Session.GetString("RolSesion");
    bool esCajero = (rolSesion == "Empleado" || rolSesion == "CAJERO");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - F&R</title>

    <link rel="icon" type="image/png" href="~/images/logo-fr.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #000000;
            font-size: 1rem;
        }

        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid #e9ecef;
        }

        .btn-black-pill {
            background-color: #000000;
            color: #ffffff;
            border-radius: 50px;
            padding: 10px 26px;
            font-weight: 800;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: none;
            text-decoration: none;
            display: inline-block;
        }

        .btn-black-pill:hover {
            background-color: #212529;
            color: #ffffff;
        }

        .card-custom {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e9ecef;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        }
    </style>
</head>
<body>

    <!-- HEADER SUPERIOR -->
    <header class="navbar-custom py-3 px-5 d-flex justify-content-between align-items-center shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="@(esCajero ? "Empleado" : "Administrador")" asp-action="Index">
                <img src="~/images/logo-fr.png" alt="F&R Logo" style="height: 42px; width: auto;" />
            </a>
            <span class="fs-5 fw-bold text-dark border-start ps-3 py-1 text-uppercase" style="letter-spacing: 1px;">
                @(esCajero ? "PANEL CAJERO" : "PANEL ADMINISTRADOR")
            </span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="fw-bold text-uppercase d-none d-md-inline" style="letter-spacing: 0.5px; font-size: 0.9rem;">
                HOLA, @(esCajero ? "CAJERO" : "ADMIN")
            </span>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold px-4 py-2" style="font-size: 0.85rem;">
                Volver a la Tienda
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-pill fw-bold px-4 py-2" style="font-size: 0.85rem;">
                Cerrar Sesión
            </a>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>