@model FRFront.Models.DifusionNotificacionViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Difusión a clientes";
    var rol = Context.Session.GetString("RolSesion");
    var tituloPanel = string.Equals(rol, "Administrador", StringComparison.OrdinalIgnoreCase) ? "ADMINISTRADOR" : "CAJERO";
}

<div class="container my-5" style="max-width: 760px;">
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="text-dark fw-bold text-uppercase text-decoration-none small">&lt; VOLVER A LA TIENDA</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <p class="text-muted text-uppercase small fw-bold mb-2">Panel @tituloPanel</p>
        <h1 class="fw-bold text-uppercase mb-2">Enviar notificación</h1>
        <p class="text-muted mb-4">El mensaje se enviará a todos los clientes activos.</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-controller="Notificacion" asp-action="Difusion" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Mensaje" class="form-label fw-bold">Mensaje</label>
                <textarea asp-for="Mensaje" class="form-control" rows="6" maxlength="1000" placeholder="Escribí el mensaje para los clientes..."></textarea>
                <span asp-validation-for="Mensaje" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Imagen" class="form-label fw-bold">Imagen (opcional)</label>
                <input asp-for="Imagen" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" />
                <span asp-validation-for="Imagen" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold text-uppercase">Enviar difusión</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
