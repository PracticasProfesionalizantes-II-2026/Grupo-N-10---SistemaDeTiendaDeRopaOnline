@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var usuarioLogueado = Context.Session.GetString("UsuarioSesion");
    var rolUsuario = Context.Session.GetString("RolSesion");
    var nombreUsuario = !string.IsNullOrEmpty(usuarioLogueado) ? usuarioLogueado.Split('@')[0] : "Usuario";

    var nombre = ViewData["Nombre"] ?? "BUZO VCV";
    var codigo = ViewData["Codigo"] ?? "VCV-001";
    var precio = ViewData["Precio"] ?? "$ 80.000,00";
    var descripcion = ViewData["Descripcion"] ?? "Este buzo está hecho para la gente elegante.";
    var imagen = ViewData["Imagen"] ?? "~/images/hombres.png";
    
    // Verificamos si el producto no tiene stock (por defecto false si tiene)
   bool sinStock = ViewData["SinStock"] != null && Convert.ToBoolean(ViewData["SinStock"]);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@nombre - F&R Tienda Online</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            background-color: #fff;
            color: #212529;
            font-family: sans-serif;
        }
        .header-top {
            border-bottom: 1px solid #e9ecef;
            padding: 15px 30px;
        }
        .ticker-fyr {
            background-color: #000;
            color: #fff;
            font-weight: bold;
            letter-spacing: 2px;
            padding: 8px 0;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
        }
        .btn-volver {
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #000;
            text-decoration: none;
            display: inline-block;
            margin: 20px 40px;
            font-size: 0.9rem;
        }
        .product-img-container {
            background-color: #f8f9fa;
            border-radius: 8px;
            border: 1px solid #e9ecef;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 450px;
            position: relative;
        }
        .product-img-container img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }
        /* Estilo visual cuando está SIN STOCK */
        .sin-stock-img {
            opacity: 0.35;
        }
        .badge-sin-stock-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border: 2px solid #dc3545;
            color: #dc3545;
            font-weight: 800;
            font-size: 1.5rem;
            padding: 10px 30px;
            text-transform: uppercase;
            letter-spacing: 3px;
            background: rgba(255, 255, 255, 0.85);
            border-radius: 6px;
        }
        .talle-btn {
            border: 1px solid #ced4da;
            background: #fff;
            color: #6c757d;
            width: 40px;
            height: 40px;
            border-radius: 4px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            text-decoration: none;
        }
        .talle-btn.active, .talle-btn:hover {
            border-color: #000;
            color: #000;
            background: #f8f9fa;
        }
        /* Estilo deshabilitado para talles sin stock */
        .talle-btn.disabled {
            background-color: #e9ecef;
            color: #adb5bd;
            border-color: #dee2e6;
            cursor: not-allowed;
            pointer-events: none;
        }
        .descripcion-box {
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            margin-top: 30px;
        }
        .user-dropdown-menu {
            border-radius: 12px;
            border: 1px solid #111;
            padding: 10px 0;
            min-width: 190px;
        }
        .footer-fyr {
            background-color: #e9ecef;
            padding: 40px 30px;
            margin-top: 60px;
            font-size: 0.85rem;
        }
        .footer-fyr h6 {
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }
        .footer-fyr ul {
            list-style: none;
            padding: 0;
        }
        .footer-fyr ul li {
            margin-bottom: 6px;
            color: #495057;
        }
    </style>
</head>
<body>

    <!-- HEADER / BARRA DE NAVEGACIÓN UNIFICADA -->
    <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <div>
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-fr.png" alt="F&R Logo" style="height: 45px; width: auto;" />
            </a>
        </div>

        <nav class="d-none d-md-flex gap-4 fw-bold text-uppercase fs-6">
            <a asp-controller="Home" asp-action="Catalogo" class="text-dark text-decoration-none">LANZAMIENTOS</a>
            <a asp-controller="Home" asp-action="Hombre" class="text-dark text-decoration-none">HOMBRE</a>
            <a asp-controller="Home" asp-action="Mujer" class="text-dark text-decoration-none">MUJER</a>
            <a asp-controller="Home" asp-action="Catalogo" class="text-dark text-decoration-none">OFERTAS</a>
            <a asp-controller="Home" asp-action="Catalogo" class="text-dark text-decoration-none">PRODUCTOS</a>
        </nav>

        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Carrito" class="text-dark text-decoration-none position-relative" title="Ver Carrito">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-bag" viewBox="0 0 16 16">
                    <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4h-3.5zM2 5h12v9H2V5z"/>
                </svg>
            </a>

            @if (!string.IsNullOrEmpty(usuarioLogueado))
            {
                @if (rolUsuario == "Administrador")
                {
                    <a asp-controller="Administrador" asp-action="Index" class="text-danger fw-bold text-decoration-none text-uppercase small me-1">
                        ADMINISTRAR
                    </a>
                }

                <div class="dropdown">
                    <button class="btn btn-dark dropdown-toggle text-uppercase fw-bold rounded-pill px-3 py-1.5" style="font-size: 0.85rem;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        MI CUENTA
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow user-dropdown-menu">
                        <li class="user-name-header text-capitalize px-3 py-2 fw-bold border-bottom">@nombreUsuario</li>
                        <li><a class="dropdown-item py-2 px-3" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        
                        @if (rolUsuario == "Administrador")
                        {
                            <li><a class="dropdown-item py-2 px-3 text-danger fw-bold" asp-controller="Administrador" asp-action="Index">Administrar Página</a></li>
                        }
                        else
                        {
                            <li><a class="dropdown-item py-2 px-3" asp-controller="Home" asp-action="Carrito">Mi Carrito</a></li>
                        }

                        <li><hr class="dropdown-divider my-1"></li>
                        <li><a class="dropdown-item py-2 px-3 text-danger fw-bold" asp-controller="Account" asp-action="Logout">Cerrar Sesión</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="text-dark fw-bold text-decoration-none text-uppercase small">
                    INICIAR SESIÓN
                </a>
            }
        </div>
    </header>

    <!-- Tira Animada -->
    <div class="ticker-fyr text-uppercase">
        <span>F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R F&R</span>
    </div>

    <!-- Botón Volver -->
    <div>
        <a asp-controller="Home" asp-action="Catalogo" class="btn-volver">
            &lt; VOLVER
        </a>
    </div>

    <!-- Contenido Principal Detalle -->
    <div class="container mb-5">
        <div class="row">
            <!-- Columna Izquierda: Imagen con efecto Sin Stock -->
            <div class="col-md-6">
                <div class="product-img-container shadow-sm">
                    <img id="productImage" src="@Url.Content(imagen.ToString())" alt="@nombre" class="@(sinStock ? "sin-stock-img" : "")" />
                    @if (sinStock)
                    {
                        <div class="badge-sin-stock-overlay">SIN STOCK</div>
                    }
                </div>

                <div class="descripcion-box">
                    <h6 class="fw-bold text-uppercase mb-2" style="font-size: 0.9rem;">DESCRIPCIÓN:</h6>
                    <p class="text-muted small m-0" style="line-height: 1.5;">@descripcion</p>
                </div>
            </div>

            <!-- Columna Derecha: Información y controles bloqueados si no hay stock -->
            <div class="col-md-6 ps-md-5">
                <h2 id="productName" class="fw-bold text-uppercase fs-3 mb-1">@nombre</h2>
                <p class="text-muted small mb-3">Código: <span id="productCode">@codigo</span></p>
                <h4 id="productPrice" class="fw-bold mb-4" style="color: #212529;">@precio</h4>

                <!-- Selección de Talle Dinámica -->
                <div class="mb-4">
                    <h6 class="fw-bold text-uppercase small mb-2">TALLE:</h6>
                    <div class="d-flex gap-2" id="tallesContainer">
                        @{
                            // Obtenemos los talles del ViewData, si no hay ninguno definido usamos por defecto S, M, L, XL
                            var tallesDisponibles = ViewData["Talles"] as string[] ?? new string[] { "S", "M", "L", "XL" };
                        }

                        @foreach (var talle in tallesDisponibles)
                        {
                            <span class="talle-btn @(sinStock ? "disabled" : "")">@talle</span>
                        }
                    </div>
                </div>

                <!-- Cantidad y Color -->
                <div class="row mb-4">
                    <div class="col-6">
                        <h6 class="fw-bold text-uppercase small mb-2">CANTIDAD:</h6>
                        <div class="input-group input-group-sm" style="max-width: 120px;">
                            <button class="btn btn-outline-secondary @(sinStock ? "disabled" : "")" type="button" id="btnRestar">-</button>
                            <input type="text" id="inputCantidad" class="form-control text-center fw-bold" value="@(sinStock ? "0" : "1")" @(sinStock ? "disabled" : "")>
                            <button class="btn btn-outline-secondary @(sinStock ? "disabled" : "")" type="button" id="btnSumar">+</button>
                        </div>
                    </div>
                    <div class="col-6">
                        <h6 class="fw-bold text-uppercase small mb-2">COLOR:</h6>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="rounded-circle border d-inline-block" style="width: 22px; height: 22px; background-color: #212529;"></span>
                            <span class="small fw-bold text-uppercase text-secondary">NEGRO</span>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción (Bloqueados si no hay stock) -->
                <div class="d-flex flex-column gap-2 mb-4">
                    @if (sinStock)
                    {
                        <button class="btn btn-secondary rounded-pill text-uppercase fw-bold py-3 shadow-sm" disabled style="letter-spacing: 1px; opacity: 0.6;">
                            Sin Stock
                        </button>
                    }
                    else
                    {
                        <button id="btnComprarAhora" class="btn btn-primary rounded-pill text-uppercase fw-bold py-3 shadow-sm" style="background-color: #4b6bfb; border: none; letter-spacing: 1px;">
                            Comprar
                        </button>
                        <button id="btnAgregarCarrito" class="btn btn-outline-dark rounded-pill text-uppercase fw-bold py-3 shadow-sm" style="letter-spacing: 1px;">
                            Agregar al Carrito
                        </button>
                    }
                </div>

                <!-- Envío -->
                <div class="border-top pt-4 mt-4">
                    <h6 class="fw-bold text-uppercase small mb-3">CALCULAR COSTO DE ENVÍO:</h6>
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Código Postal</label>
                        <div class="d-flex gap-2" style="max-width: 280px;">
                            <input type="text" class="form-control form-control-sm rounded" value="2322">
                            <button class="btn btn-outline-dark btn-sm text-uppercase fw-bold" style="font-size: 0.75rem;">Calcular</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-fyr">
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <h6>Productos</h6>
                    <ul>
                        <li>Buzos</li>
                        <li>Camisas</li>
                        <li>Sweater</li>
                        <li>Remeras</li>
                        <li>Pantalones</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Ayudas</h6>
                    <ul>
                        <li>Preguntas Frecuentes</li>
                        <li>Envíos</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Contactanos</h6>
                    <ul>
                        <li>📞 3564-485238</li>
                        <li>✉️ fyr_tienda.online@gmail.com</li>
                        <li>📍 Sunchales, Santa Fe</li>
                        <li>📷 @@FR.OFICIAL</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Medios de Pago</h6>
                    <ul>
                        <li>Efectivo</li>
                        <li>Tarjeta de Débito</li>
                        <li>Tarjeta de Crédito</li>
                        <li>Transferencia</li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            let talleSeleccionado = "";

            // Solo permite seleccionar si hay stock
            $('.talle-btn').click(function () {
                if ($(this).hasClass('disabled')) return;
                $('.talle-btn').removeClass('active');
                $(this).addClass('active');
                talleSeleccionado = $(this).text();
            });

            let cantidad = 1;
            const inputCantidad = $('#inputCantidad');

            $('#btnSumar').click(function () {
                cantidad++;
                inputCantidad.val(cantidad);
            });

            $('#btnRestar').click(function () {
                if (cantidad > 1) {
                    cantidad--;
                    inputCantidad.val(cantidad);
                }
            });

            function agregarAlCarrito() {
                if (!talleSeleccionado) {
                    alert('Por favor, selecciona un talle antes de continuar.');
                    return false;
                }

                const producto = {
                    nombre: $('#productName').text(),
                    codigo: $('#productCode').text(),
                    precio: $('#productPrice').text(),
                    talle: talleSeleccionado,
                    cantidad: parseInt(inputCantidad.val()),
                    imagen: $('#productImage').attr('src')
                };

                let carrito = JSON.parse(localStorage.getItem('fyr_carrito')) || [];
                carrito.push(producto);
                localStorage.setItem('fyr_carrito', JSON.stringify(carrito));
                return true;
            }

            $('#btnAgregarCarrito').click(function () {
                if (agregarAlCarrito()) {
                    alert('¡Producto agregado al carrito con éxito!');
                }
            });

            $('#btnComprarAhora').click(function () {
                if (agregarAlCarrito()) {
                    window.location.href = '@Url.Action("Carrito", "Home")';
                }
            });
        });
    </script>
</body>
</html>