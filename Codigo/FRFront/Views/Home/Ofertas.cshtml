@model IEnumerable<FRFront.Models.Producto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Ofertas";
}

<!-- Banner Estilo General (Negro con imagen a la derecha) -->
<div class="banner-ofertas d-flex justify-content-between align-items-center bg-black text-white p-4 mx-4 my-3 rounded" style="background-color: #111 !important;">
    <div>
        <h6 class="text-uppercase mb-1" style="font-size: 0.75rem; color: #adb5bd;">F&R TIENDA ONLINE</h6>
        <h1 class="fw-bold text-uppercase fs-3 m-0">¡OFERTAS IMPERDIBLES!</h1>
        <div class="mt-3 d-flex gap-2">
            <span class="badge bg-light text-dark fw-bold px-3 py-2 rounded-pill" style="font-size: 0.7rem;">HASTA 50% OFF</span>
            <span class="badge bg-secondary text-white fw-bold px-3 py-2 rounded-pill" style="font-size: 0.7rem;">HASTA 9 CUOTAS SIN INTERÉS</span>
        </div>
    </div>
    <div class="d-none d-md-block">
        <img src="~/images/banner.png" alt="Banner" style="max-height: 120px; border-radius: 4px;" />
    </div>
</div>

<div class="container-fluid px-4 my-4">
    <div class="row">
        <!-- Sidebar Izquierdo Unificado -->
        <div class="col-lg-3 pe-4 mb-4">
            <h6 class="fw-bold text-uppercase mb-3" style="font-size: 0.85rem; color: #6c757d; letter-spacing: 1px;">Categorías</h6>
            <ul class="list-unstyled d-flex flex-column gap-2">
                <li><a asp-controller="Home" asp-action="Mujer" class="text-dark text-decoration-none">MUJER</a></li>
                <li><a asp-controller="Home" asp-action="Hombre" class="text-dark text-decoration-none">HOMBRE</a></li>
                <li><a asp-controller="Home" asp-action="Ofertas" class="text-danger text-decoration-none fw-bold"><strong>OFERTAS</strong></a></li>
                <li><a asp-controller="Home" asp-action="Catalogo" class="text-dark text-decoration-none">VER TODO</a></li>
            </ul>
        </div>

        <!-- Grilla de Productos (Derecha) -->
        <div class="col-lg-9">
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    @foreach (var prod in Model)
                    {
                        <div class="col-md-4">
                            <a asp-controller="Home" asp-action="DetalleProducto" asp-route-nombre="@prod.Nombre" class="card h-100 text-decoration-none text-dark border shadow-sm bg-light" style="border-radius: 10px; overflow: hidden;">
                                <div class="bg-light p-3 text-center position-relative" style="height: 250px; display: flex; align-items: center; justify-content: center;">
                                    @if (prod.SinStock)
                                    {
                                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-75 text-white fw-bold text-uppercase" style="letter-spacing: 2px; z-index: 2;">
                                            SIN STOCK
                                        </div>
                                    }
                                    <img src="@Url.Content(prod.Imagen)" alt="@prod.Nombre" class="img-fluid h-100 object-fit-contain" />
                                </div>
                                <div class="card-body text-center bg-white border-top">
                                    <h6 class="card-title fw-semibold small text-uppercase">@prod.Nombre</h6>
                                    
                                    <div class="d-flex justify-content-center gap-2 align-items-center mt-2">
                                        @if (prod.PrecioAnterior.HasValue && prod.PrecioAnterior.Value > prod.Precio)
                                        {
                                            <span class="text-muted text-decoration-line-through small" style="font-size: 0.8rem;">$@prod.PrecioAnterior.Value.ToString("N0")</span>
                                            <span class="fw-bold text-danger mb-0" style="font-size: 0.95rem;">$@prod.Precio.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">$@prod.Precio.ToString("N0")</span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-muted">No hay productos en oferta disponibles.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>