@model IEnumerable<FRFront.Models.Producto>

@{
    Layout = "_Layout"; // O el layout que uses
    var titulo = ViewData["TituloSeccion"] ?? "CATÁLOGO";
}

<div class="container my-4">
    <a href="javascript:history.back()" class="text-dark fw-bold text-decoration-none">&lt; VOLVER</a>
    <h2 class="text-center text-uppercase fw-bold my-3">@titulo</h2>

    <div class="row">
        <!-- Menú lateral de categorías -->
        <div class="col-md-3 mb-4">
            <h6 class="fw-bold text-uppercase mb-3">Categorías:</h6>
            <ul class="list-unstyled d-flex flex-column gap-2">
                <li><a asp-action="Hombre" class="text-dark text-decoration-none fw-semibold">VER TODO</a></li>
                <li><a asp-action="Hombre" asp-route-categoria="Remeras" class="text-dark text-decoration-none">REMERAS</a></li>
                <li><a asp-action="Hombre" asp-route-categoria="Pantalones" class="text-dark text-decoration-none">PANTALONES</a></li>
                <li><a asp-action="Hombre" asp-route-categoria="Abrigos" class="text-dark text-decoration-none">ABRIGOS</a></li>
            </ul>
        </div>

        <!-- Grilla de productos -->
        <div class="col-md-9">
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    @foreach (var prod in Model)
                    {
                        <div class="col-md-4">
                            <a asp-controller="Home" asp-action="DetalleProducto" asp-route-nombre="@prod.Nombre" class="card h-100 text-decoration-none text-dark border-light shadow-sm">
                                <div class="bg-light p-3 text-center position-relative" style="height: 250px;">
                                    @if (prod.SinStock)
                                    {
                                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-white fw-bold text-uppercase" style="letter-spacing: 2px; z-index: 2;">
                                            SIN STOCK
                                        </div>
                                    }
                                    <img src="@Url.Content(prod.Imagen)" alt="@prod.Nombre" class="img-fluid h-100 object-fit-cover" />
                                </div>
                                <div class="card-body text-center">
                                    <h6 class="card-title fw-semibold small text-uppercase">@prod.Nombre</h6>
                                    <p class="fw-bold text-dark mb-0">$@prod.Precio.ToString("N0")</p>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No hay productos disponibles en esta categoría.</p>
                }
            </div>
        </div>
    </div>
</div>