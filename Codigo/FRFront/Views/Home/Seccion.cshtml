@model IEnumerable<FRFront.Models.Producto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var titulo = ViewData["TituloSeccion"] ?? "CATÁLOGO";
    var generoActual = ViewData["GeneroActual"]?.ToString() ?? "";
}

<!-- Banner Estilo Unificado (Fondo Negro Oscuro igual a las demás secciones) -->
<div class="banner-ofertas d-flex justify-content-between align-items-center text-white p-4 mx-4 my-3 rounded" style="background-color: #111 !important;">
    <div>
        <h6 class="text-uppercase mb-1" style="font-size: 0.75rem; color: #adb5bd;">F&R Tienda Online</h6>
        <h1 class="fw-bold text-uppercase fs-3 m-0">@titulo</h1>
        <div class="mt-3 d-flex gap-2">
            <span class="badge bg-light text-dark fw-bold px-3 py-2 rounded-pill" style="font-size: 0.7rem;">ENVÍO A TODO EL PAÍS</span>
            <span class="badge bg-secondary text-white fw-bold px-3 py-2 rounded-pill" style="font-size: 0.7rem;">TENDENCIA URBANA</span>
        </div>
    </div>
</div>

<partial name="_CatalogoProductos" model="Model" />