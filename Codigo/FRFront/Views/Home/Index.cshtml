@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <style>
        .ticker-fyr {
            background-color: #000;
            color: #fff;
            overflow: hidden;
            white-space: nowrap;
            padding: 8px 0;
            font-size: 0.9rem;
            font-weight: bold;
            letter-spacing: 2px;
            width: 100%;
        }

        .ticker-track {
            display: inline-block;
            white-space: nowrap;
            animation: ticker 25s linear infinite;
        }

        .ticker-track span {
            display: inline-block;
        }

        @@keyframes ticker {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* Estilo elegante para las tarjetas de la página principal */
        .fyr-card-home {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 12px;
            overflow: hidden;
        }

        .fyr-card-home:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }
    </style>
}

<!-- Tira Animada 1 -->
<div class="ticker-fyr">
    <div class="ticker-track">
        <span>F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp;&nbsp;&nbsp;</span>
        <span>F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
</div>

<!-- BANNER PRINCIPAL -->
<section class="hero-fyr mb-5">
    <a asp-controller="Home" asp-action="Catalogo">
        <img src="~/images/banner.png" alt="Nueva colección F&R" class="w-100 object-fit-cover" style="max-height: 480px;" />
    </a>
</section>

<!-- Tira Animada 2 -->
<div class="ticker-fyr mb-5">
    <div class="ticker-track">
        <span>F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp;&nbsp;&nbsp;</span>
        <span>F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp; F&R &nbsp;&nbsp;&nbsp;&nbsp;</span>
    </div>
</div>

<!-- ========================================================= -->
<!-- GRILLA DE CATEGORÍAS PRINCIPALES -->
<!-- ========================================================= -->
<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">
        
        <!-- Tarjeta 1: Nuevo -->
        <div class="col">
            <a asp-controller="Home" asp-action="Catalogo" class="card fyr-card-home h-100 text-decoration-none text-dark border shadow-sm bg-light">
                <div class="p-4 text-center" style="height: 320px; display: flex; align-items: center; justify-content: center;">
                    <img src="~/images/hombres3.png" alt="Nuevo" class="img-fluid h-100 object-fit-contain" />
                </div>
                <div class="card-body text-center bg-white border-top">
                    <h5 class="fw-bold text-uppercase m-0">NUEVO</h5>
                </div>
            </a>
        </div>

        <!-- Tarjeta 2: Mujeres -->
        <div class="col">
            <a asp-controller="Home" asp-action="Mujer" class="card fyr-card-home h-100 text-decoration-none text-dark border shadow-sm bg-light">
                <div class="p-4 text-center" style="height: 320px; display: flex; align-items: center; justify-content: center;">
                    <img src="~/images/mujeres.png" alt="Mujeres" class="img-fluid h-100 object-fit-contain" />
                </div>
                <div class="card-body text-center bg-white border-top">
                    <h5 class="fw-bold text-uppercase m-0">MUJERES</h5>
                </div>
            </a>
        </div>

        <!-- Tarjeta 3: Hombres -->
        <div class="col">
            <a asp-controller="Home" asp-action="Hombre" class="card fyr-card-home h-100 text-decoration-none text-dark border shadow-sm bg-light">
                <div class="p-4 text-center" style="height: 320px; display: flex; align-items: center; justify-content: center;">
                    <img src="~/images/hombres2.png" alt="Hombres" class="img-fluid h-100 object-fit-contain" />
                </div>
                <div class="card-body text-center bg-white border-top">
                    <h5 class="fw-bold text-uppercase m-0">HOMBRES</h5>
                </div>
            </a>
        </div>

    </div>
</div>

<!-- ========================================================= -->
<!-- BARRA PROMO -->
<!-- ========================================================= -->
<section class="promo-bar py-4 bg-dark text-white text-center my-5 position-relative">
    <div class="container d-flex justify-content-between align-items-center">
        <span class="fw-bold text-uppercase tracking-wide" style="font-size: 1.1rem; letter-spacing: 2px;">ENVÍO A TODO EL PAÍS</span>
