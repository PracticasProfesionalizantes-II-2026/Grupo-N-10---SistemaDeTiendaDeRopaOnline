@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inicio";
}

<!-- CATEGORÍAS -->
<section class="categories-fyr my-4">
    <div class="categories-container">
        <a asp-controller="Home" asp-action="Catalogo" class="category-card">
            <img src="~/images/nuevo.png" alt="Nueva colección" />
            <div class="category-button">NUEVO</div>
        </a>
        <a asp-controller="Home" asp-action="Mujer" class="category-card">
            <img src="~/images/mujeres.png" alt="Mujeres" />
            <div class="category-button">MUJERES</div>
        </a>
        <a asp-controller="Home" asp-action="Hombre" class="category-card">
            <img src="~/images/hombres.png" alt="Hombres" />
            <div class="category-button">HOMBRES</div>
        </a>
    </div>
</section>

<!-- BARRA PROMOCIONAL -->
<section class="promo-bar">
    <span class="promo-text">ENVÍO A TODO EL PAÍS</span>
    <a asp-controller="Home" asp-action="Ofertas" class="promo-circle text-decoration-none">
        <span>OFERTAS!</span>
    </a>
</section>

<!-- PRODUCTOS DESTACADOS -->
<section class="featured-products my-5">
    <div class="products-container">
        <a asp-controller="Home" asp-action="Catalogo" class="product-card">
            <img src="~/images/hombres2.png" alt="Producto destacado" />
        </a>
        <a asp-controller="Home" asp-action="Catalogo" class="product-card">
            <img src="~/images/mujeres2.png" alt="Producto destacado" />
        </a>
        <a asp-controller="Home" asp-action="Catalogo" class="product-card">
            <img src="~/images/hombres3.png" alt="Producto destacado" />
        </a>
    </div>
</section>

<!-- SECCIÓN SALE -->
<section class="sale-section my-5">
    <a asp-controller="Home" asp-action="Ofertas" class="text-decoration-none">
        <div class="sale-banner">
            <img src="~/images/sale.png" alt="Sale" class="sale-image sale-image-left" />
            <h2 class="sale-title">SALE</h2>
            <img src="~/images/off.png" alt="Ofertas" class="sale-image sale-image-right" />
        </div>
    </a>
</section>