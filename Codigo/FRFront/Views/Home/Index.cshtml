<!-- ========================================================= -->
<!-- BANNER SALE -->
<!-- ========================================================= -->
<section class="sale-section my-5">
    <a asp-controller="Home" asp-action="Ofertas" class="text-decoration-none">
        <div class="bg-black text-white p-5 text-center position-relative overflow-hidden">
