@using Microsoft.AspNetCore.Http
@model FRFront.Models.PedidoDto
@{
    Layout = null;
    ViewData["Title"] = "Detalle del Pedido";

    var rolSesion = Context.Session.GetString("RolSesion") 
                 ?? Context.Session.GetString("RolUsuario") 
                 ?? "Administrador";

    string controladorVolver = (rolSesion.Equals("Empleado", StringComparison.OrdinalIgnoreCase) || rolSesion.Equals("Cajero", StringComparison.OrdinalIgnoreCase)) 
        ? "Empleado" 
        : "Administrador";

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F&R - Detalle del Pedido</title>
    
    <link rel="icon" type="image/png" href="~/images/logo-fr.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .detail-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid #e9ecef;
            padding: 35px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
        }

        .label-custom {
            font-size: 0.8rem;
            font-weight: 800;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-select-custom {
            border-radius: 50px;
            padding: 10px 20px;
            border: 1px solid #ced4da;
            font-weight: 700;
            text-transform: uppercase;
        }

        .btn-save {
            background-color: #000;
            color: #fff;
            border-radius: 50px;
            padding: 12px 35px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-save:hover {
            background-color: #212529;
            color: #fff;
            transform: translateY(-1px);
        }

        .product-box {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 15px 20px;
            border: 1px solid #e9ecef;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-fr.png" alt="F&R Logo" style="height: 45px; width: auto;" />
            </a>
            <span class="fs-5 fw-bold text-dark border-start ps-3 py-1">DETALLE DEL PEDIDO</span>
        </div>

        <div>
            <a asp-controller="@controladorVolver" asp-action="Pedidos" class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3">
                &lt; VOLVER
            </a>
        </div>
    </header>

    <div class="container py-5" style="max-width: 900px;">

        <!-- ALERTAS DE NOTIFICACIÓN -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-pill px-4 mb-4 fw-bold text-center shadow-sm" role="alert">
                ✨ @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-pill px-4 mb-4 fw-bold text-center shadow-sm" role="alert">
                ⚠️ @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="detail-card">
            
            <div class="text-center mb-4">
                <h2 class="fw-black text-uppercase" style="font-weight: 900;">RESUMEN PEDIDO</h2>
            </div>

            <form asp-controller="@controladorVolver" asp-action="ActualizarEstadoPedido" method="post" id="formPedido">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row g-4 mb-4">
                    
                    <!-- N° PEDIDO -->
                    <div class="col-12 col-md-6">
                        <label class="label-custom mb-1">N° PEDIDO:</label>
                        <input type="text" class="form-control rounded-pill px-3 fw-bold bg-light" value="@Model.NumeroPedido" readonly />
                    </div>

                    <!-- TOTAL -->
                    <div class="col-12 col-md-6">
                        <label class="label-custom mb-1">TOTAL:</label>
                        <input type="text" class="form-control rounded-pill px-3 fw-bold bg-light" value="$ @Model.Total.ToString("N2")" readonly />
                    </div>

                    <!-- CLIENTE -->
                    <div class="col-12 col-md-6">
                        <label class="label-custom mb-1">CLIENTE:</label>
                        <input type="text" class="form-control rounded-pill px-3 fw-bold bg-light text-uppercase" value="@Model.Cliente" readonly />
                    </div>

                    <!-- ESTADO DEL PEDIDO (EDITABLE) -->
                    <div class="col-12 col-md-6">
                        <label class="label-custom mb-1 text-primary">ESTADO DEL PEDIDO:</label>
                        <select name="nuevoEstado" class="form-select form-select-custom shadow-sm" required>
                            <option value="CONFIRMADO" selected="@(Model.Estado.ToUpper() == "CONFIRMADO")">CONFIRMADO</option>
                            <option value="EN CAMINO" selected="@(Model.Estado.ToUpper() == "EN CAMINO")">EN CAMINO</option>
                            <option value="ENTREGADO" selected="@(Model.Estado.ToUpper() == "ENTREGADO")">ENTREGADO</option>
                            <option value="CANCELADO" selected="@(Model.Estado.ToUpper() == "CANCELADO")">CANCELADO</option>
                        </select>
                    </div>

                    <!-- FECHA -->
                    <div class="col-12 col-md-6">
                        <label class="label-custom mb-1">FECHA:</label>
                        <input type="text" class="form-control rounded-pill px-3 fw-bold bg-light" value="@Model.Fecha.ToString("dd/MM/yy")" readonly />
                    </div>

                    <!-- TIPO DE ENTREGA -->
                    <div class="col-12 col-md-6">
                        <label class="label-custom mb-1">TIPO DE ENTREGA:</label>
                        <input type="text" class="form-control rounded-pill px-3 fw-bold bg-light text-uppercase" value="@Model.TipoEntrega" readonly />
                    </div>

                </div>

                <!-- DETALLE DE PRODUCTOS -->
                <div class="mt-4 pt-3 border-top">
                    <label class="label-custom mb-3 d-block">PRODUCTOS SOLICITADOS:</label>

                    <div class="d-flex flex-column gap-2">
                        @if (Model.Detalle != null && Model.Detalle.Any())
                        {
                            foreach (var prod in Model.Detalle)
                            {
                                <div class="product-box d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-uppercase">@prod.ProductoNombre</span>
                                    <span class="badge bg-dark rounded-pill px-3 py-2 fw-bold">CANTIDAD: @prod.Cantidad</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="product-box text-center text-muted fw-bold">
                                Sin información detallada de items.
                            </div>
                        }
                    </div>
                </div>

                <!-- BOTÓN GUARDAR -->
                <div class="text-center mt-5">
                    <button type="submit" class="btn-save shadow-sm">
                        GUARDAR
                    </button>
                </div>

            </form>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Desaparición progresiva de las alertas luego de 3.5 segundos
        setTimeout(() => {
            let alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                let bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 3500);
    </script>
</body>
</html>