@model IEnumerable<FRFront.Models.ClienteDto>

@{
    ViewData["Title"] = "Gestión de Clientes";
    Layout = "_LayoutAdministrador";
    string? rolSesion = Context.Session.GetString("RolSesion");
    bool esCajero = (rolSesion == "Empleado" || rolSesion == "CAJERO");
}

<div class="container-fluid py-5 px-4 px-md-5" style="max-width: 1400px;">

    <!-- ENCABEZADO Y BOTÓN VOLVER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-controller="@(esCajero ? "Empleado" : "Administrador")" asp-action="Index" class="btn btn-outline-dark rounded-pill fw-bold px-4 py-2 mb-3" style="font-size: 0.85rem;">
                &lt; Volver al Panel
            </a>
            <h1 class="fw-black text-uppercase mb-2" style="font-weight: 900; font-size: 2.6rem; letter-spacing: 1px;">GESTIÓN DE CLIENTES</h1>
            <p class="text-muted fs-6 mb-0">Listado y administración de perfiles de clientes registrados</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-pill px-4 py-3 mb-4 shadow-sm fs-6" role="alert">
            <strong>✓ Éxito:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BUSCADOR -->
    <div class="card-custom p-4 mb-4">
        <form method="get" asp-controller="Administrador" asp-action="Clientes" class="row g-3 align-items-center">
            <div class="col-12 col-md-10">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-light border-0 rounded-pill-start ps-4">🔍</span>
                    <input type="text" name="busqueda" value="@ViewBag.BusquedaActual" class="form-control bg-light border-0 rounded-pill-end py-3 fs-6" placeholder="Buscar cliente por DNI, nombre, email o número de cliente...">
                </div>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-dark w-100 rounded-pill fw-bold py-3 fs-6" style="letter-spacing: 0.5px;">BUSCAR</button>
            </div>
        </form>
    </div>

    <!-- TABLA DE CLIENTES -->
    <div class="card-custom p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr class="text-uppercase fw-bold text-muted" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                        <th class="ps-4 py-4">CÓDIGO</th>
                        <th class="py-4">DNI</th>
                        <th class="py-4">CLIENTE</th>
                        <th class="py-4">EMAIL</th>
                        <th class="py-4">TELÉFONO</th>
                        <th class="py-4">FECHA ALTA</th>
                        <th class="py-4">ESTADO</th>
                        <th class="text-end pe-4 py-4">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cliente in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold text-dark fs-6">@cliente.NumeroCliente</td>
                                <td class="py-3 fw-bold text-dark fs-6">@(string.IsNullOrEmpty(cliente.Dni) ? "S/D" : cliente.Dni)</td>
                                <td class="py-3">
                                    <span class="fw-bold text-dark d-block fs-6">@cliente.NombreCompleto</span>
                                </td>
                                <td class="py-3 text-muted fs-6">@cliente.Email</td>
                                <td class="py-3 text-muted fs-6">@cliente.Telefono</td>
                                <td class="py-3 text-muted fs-6">@cliente.FechaAlta.ToString("dd/MM/yyyy")</td>
                                <td class="py-3">
                                    @if (cliente.Estado == "ACTIVO")
                                    {
                                        <span class="badge bg-dark text-white rounded-pill px-3 py-2 fs-6">ACTIVO</span>
                                    }
                                    else if (cliente.Estado == "INACTIVO")
                                    {
                                        <span class="badge bg-secondary text-white rounded-pill px-3 py-2 fs-6">INACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-2 fs-6">BLOQUEADO</span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="dropdown">
                                        <button class="btn btn-md btn-light rounded-circle border px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            ⋮
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2">
                                            <li>
                                                <a class="dropdown-item fw-bold py-2 fs-6" asp-controller="Administrador" asp-action="DetalleCliente" asp-route-id="@cliente.Id">
                                                    👁 Ver Detalle
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item fw-bold py-2 fs-6" asp-controller="Administrador" asp-action="HistorialCliente" asp-route-id="@cliente.Id">
                                                    📜 Historial de Compras
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted fs-5">
                                No se encontraron clientes registrados con los criterios ingresados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>