@model IEnumerable<FRFront.Models.ClienteDto>

@{
    ViewData["Title"] = "F&R - Gestión de Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-main-container {
        min-height: 75vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }
    .btn-volver-panel {
        border: 1px solid #000;
        border-radius: 20px;
        color: #000;
        background-color: #fff;
        padding: 5px 18px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
    }
    .btn-volver-panel:hover {
        background-color: #000;
        color: #fff;
    }
    .search-box-container {
        background-color: #f9f9f9;
        border-radius: 30px;
        padding: 6px 6px 6px 20px;
    }
    .search-input {
        border: none;
        background: transparent;
        outline: none;
        box-shadow: none !important;
        font-size: 14px;
        color: #333;
    }
    .btn-buscar-custom {
        background-color: #1a202c;
        color: #fff;
        border-radius: 20px;
        padding: 8px 30px;
        font-weight: 700;
        font-size: 13px;
        border: none;
        letter-spacing: 0.5px;
    }
    .btn-buscar-custom:hover {
        background-color: #000;
        color: #fff;
    }
    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }
    .table-custom th {
        font-size: 12px;
        font-weight: 800;
        color: #4a5568;
        letter-spacing: 0.5px;
        border-bottom: 1px solid #edf2f7;
        background-color: #fff;
        padding-top: 16px;
        padding-bottom: 16px;
    }
    .table-custom td {
        font-size: 14px;
        color: #2d3748;
        padding-top: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f7fafc;
    }
    .badge-activo {
        background-color: #1a202c;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 12px;
        letter-spacing: 0.5px;
    }
    .badge-inactivo {
        background-color: #e2e8f0;
        color: #4a5568;
        font-size: 11px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 12px;
        letter-spacing: 0.5px;
    }
    .dropdown-toggle-custom {
        background: transparent;
        border: none;
        color: #a0aec0;
        font-size: 18px;
        cursor: pointer;
        padding: 0 8px;
    }
    .dropdown-toggle-custom:hover {
        color: #1a202c;
    }
    .dropdown-menu-custom {
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        border-radius: 8px;
        padding: 6px 0;
    }
    .dropdown-menu-custom .dropdown-item {
        font-size: 13px;
        padding: 8px 16px;
        color: #2d3748;
        font-weight: 500;
    }
    .dropdown-menu-custom .dropdown-item:hover {
        background-color: #f7fafc;
        color: #000;
    }
</style>

<div class="container my-5 px-4 page-main-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-black text-uppercase mb-1" style="font-size: 32px; letter-spacing: -0.5px; font-weight: 900;">
                GESTIÓN DE CLIENTES
            </h1>
            <p class="text-secondary mb-0" style="font-size: 14px;">
                Listado y administración de perfiles de clientes registrados
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Empleado")" class="btn-volver-panel">
                &lt; Volver al Panel
            </a>
        </div>
    </div>

    <!-- Barra de Búsqueda -->
    <div class="search-box-container mb-5">
        <form method="get" action="@Url.Action("Clientes", "Administrador")">
            <div class="d-flex align-items-center">
                <input type="text" name="busqueda" value="@ViewBag.BusquedaActual" 
                       class="form-control search-input w-100" 
                       placeholder="Buscar cliente por DNI, nombre, email o teléfono..." />
                <button type="submit" class="btn-buscar-custom ms-2">
                    BUSCAR
                </button>
            </div>
        </form>
    </div>

    <!-- Tabla -->
    <div class="table-responsive mb-5">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr class="text-uppercase text-center">
                    <th class="text-start">CÓDIGO</th>
                    <th>DNI</th>
                    <th class="text-start">CLIENTE</th>
                    <th>EMAIL</th>
                    <th>TELÉFONO</th>
                    <th>FECHA ALTA</th>
                    <th>ESTADO</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var cliente in Model)
                    {
                        string codigoCliente = string.IsNullOrEmpty(cliente.NumeroCliente) || cliente.NumeroCliente == "CLI-000"
                            ? $"CLI-{cliente.Id:D3}"
                            : cliente.NumeroCliente;

                        string telefonoMostrar = string.IsNullOrWhiteSpace(cliente.Telefono) ? "Sin registrar" : cliente.Telefono;
                        string dniMostrar = string.IsNullOrWhiteSpace(cliente.Dni) ? "S/D" : cliente.Dni;

                        <tr class="text-center">
                            <td class="fw-bold text-start">@codigoCliente</td>
                            <td>@dniMostrar</td>
                            <td class="fw-bold text-start text-capitalize">@cliente.NombreCompleto</td>
                            <td class="text-lowercase text-muted">@cliente.Email</td>
                            <td class="text-muted">@telefonoMostrar</td>
                            <td>@cliente.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="@(cliente.Estado == "ACTIVO" ? "badge-activo" : "badge-inactivo")">
                                    @cliente.Estado
                                </span>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="dropdown-toggle-custom" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        &#8942;
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom">
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("DetalleCliente", "Administrador", new { id = cliente.Id })">
                                                Ver Ficha
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("HistorialCliente", "Administrador", new { id = cliente.Id })">
                                                Historial de Compras
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            No se encontraron clientes registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>