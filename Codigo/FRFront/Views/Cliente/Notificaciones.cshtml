@model List<FRFront.Models.NotificacionModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Notificaciones";
}

<div class="container my-5" style="max-width: 800px;">
    
    <!-- Encabezado / Volver -->
    <div class="mb-4 pb-3 border-bottom">
        <a asp-controller="Home" asp-action="Index" class="text-dark fw-bold text-uppercase text-decoration-none small" style="letter-spacing: 1px;">
            &lt; VOLVER
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
        
        <h2 class="fw-bold text-uppercase mb-5" style="letter-spacing: 2px; font-size: 1.8rem;">NOTIFICACIONES</h2>

        @if (Model != null && Model.Count > 0)
        {
            <!-- Listado cuando SÍ hay notificaciones -->
            <div class="d-flex flex-column gap-3 text-start mb-4">
                @foreach (var noti in Model)
                {
                    <div class="p-4 rounded-4 border bg-light shadow-sm position-relative">
                        <div class="d-flex align-items-start gap-3">
                            <div class="bg-dark text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; min-width: 45px;">
                                @if (noti.Tipo == "Envio")
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-truck" viewBox="0 0 16 16">
                                        <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7zm1.294 7.494A1.995 1.995 0 0 1 3 11h2c0 .734.445 1.366 1.08 1.648-.862.33-1.5.83-1.5 1.352 0 .584.825 1.11 2.02 1.39C8.32 15.75 9.68 16 11 16s2.68-.25 3.42-.61c1.195-.28 2.02-.806 2.02-1.39 0-.522-.638-1.022-1.5-1.352.635-.282 1.08-.914 1.08-1.648h.5a.5.5 0 0 0 .5-.5v-3.5a.5.5 0 0 0-.146-.354l-1.48-1.85a.5.5 0 0 0-.354-.146H12v2.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V9.5H1.294v1.5z"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-tag" viewBox="0 0 16 16">
                                        <path d="M6 4.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm-1 0a.5.5 0 1 0-1 0 .5.5 0 0 0 1 0z"/>
                                        <path d="M2 1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 1 6.586V2a1 1 0 0 1 1-1zM2 2v4.586l7 7L13.586 9l-7-7H2z"/>
                                    </svg>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h5 class="fw-bold m-0 text-dark" style="font-size: 1.05rem;">@noti.Titulo</h5>
                                    <span class="text-muted small">@noti.Fecha</span>
                                </div>
                                <p class="text-secondary small m-0">@noti.Mensaje</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Estado: SIN NOTIFICACIONES (Idéntico a Figma) -->
            <div class="py-5">
                <!-- Icono de Campanita Minimalista -->
                <div class="mb-4 text-dark">
                    <svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                </div>

                <h4 class="fw-bold mb-2" style="font-size: 1.3rem;">No tienes notificaciones</h4>
                <p class="text-muted mb-5" style="font-size: 0.95rem;">¡Aprovecá las ofertas!</p>

                <div>
                    <a asp-controller="Home" asp-action="Catalogo" class="btn btn-primary rounded-pill px-5 py-3 text-uppercase fw-bold shadow-sm" style="background-color: #4b6bfb; border: none; letter-spacing: 1.5px;">
                        Ver Ofertas &rarr;
                    </a>
                </div>
            </div>
        }

    </div>
</div>