@model FRFront.Models.PedidoModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Seguir Envío";

    // Verificamos si es un pedido para retirar en el local
    bool esRetiroLocal = Model.DetalleFecha != null && 
        (Model.DetalleFecha.Contains("retirar", StringComparison.OrdinalIgnoreCase) || 
         Model.DetalleFecha.Contains("local", StringComparison.OrdinalIgnoreCase));
}

<div class="container my-5" style="max-width: 800px;">
    
    <!-- Botón Volver -->
    <a asp-controller="Cliente" asp-action="MisCompras" class="text-dark fw-bold text-uppercase text-decoration-none small mb-4 d-inline-block" style="letter-spacing: 1px;">
        &lt; Volver a Mis Compras
    </a>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
        
        <h2 class="fw-bold text-uppercase mb-4" style="letter-spacing: 1.5px; font-size: 1.4rem;">
            @(esRetiroLocal ? "Estado del pedido" : "Seguir Envío") - Pedido @Model.NroPedido
        </h2>

        <!-- Tarjeta Central de Seguimiento -->
        <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm mx-auto text-start w-100" style="max-width: 600px;">
            
            @if (esRetiroLocal)
            {
                <!-- Diseño exclusivo para Retiro en el Local -->
                <div class="text-center py-4">
                    <div class="mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" fill="currentColor" class="bi bi-shop text-dark" viewBox="0 0 16 16">
                            <path d="M2.97 1.35A1 1 0 0 1 3.73 1h8.54a1 1 0 0 1 .76.35l2.609 3.044A1.5 1.5 0 0 1 16 5.38v.262a2.5 2.5 0 0 1-1.258 2.158A3.5 3.5 0 0 1 13 11.5a3.5 3.5 0 1 1-6.164-2.25h-1.672A3.5 3.5 0 1 1 2 11.5c0 .776.262 1.49.71 2.057a1.5 1.5 0 0 1-1.258-2.158v-.262a1.5 1.5 0 0 1 .379-1.015zM6 11a2.5 2.5 0 1 0 5 0 2.5 2.5 0 0 0-5 0m1.5-7.5v1h3V3.5zM3.5 5h9l-1.07-1.25a.5.5 0 0 0-.38-.17H4.95a.5.5 0 0 0-.38.17z"/>
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Tu pedido te está esperando en el local</h4>
                    <p class="text-secondary small mb-4">Podes pasar a retirarlo por nuestro local en Sunchales, Santa Fe, con tu número de pedido <strong>@Model.NroPedido</strong>.</p>
                    
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block fw-bold text-success small text-uppercase mb-1">Estado actual</span>
                        <span class="text-dark fw-semibold">Listo para retirar</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Diseño de Línea de Tiempo para Envíos a Domicilio -->
                <div class="text-center mb-5">
                    <div class="mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-truck text-dark" viewBox="0 0 16 16">
                            <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.49A1.995 1.995 0 0 1 3 11h2c0 .733.6 1.33 1.333 1.333S7.667 11.733 7.667 11H9.5a1.5 1.5 0 0 1 1.5 1.5v.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-.5a1.5 1.5 0 0 1 .794-1.348zM10 5V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5V5zM13 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark m-0 fs-5">
                        @Model.DetalleFecha
                    </h5>
                </div>

                <div class="timeline-container position-relative ps-4 ms-md-5">
                    <div class="position-absolute bg-primary" style="width: 3px; top: 10px; bottom: 10px; left: 6px; background-color: #3b55ff !important;"></div>

                    <div class="timeline-step mb-4 position-relative">
                        <span class="position-absolute bg-dark rounded-circle" style="width: 12px; height: 12px; left: -25px; top: 4px;"></span>
                        <span class="text-muted small fw-semibold d-block">9:00 am</span>
                        <span class="text-dark fw-bold">Tu pedido está en proceso</span>
                    </div>

                    <div class="timeline-step mb-4 position-relative">
                        <span class="position-absolute bg-dark rounded-circle" style="width: 12px; height: 12px; left: -25px; top: 4px;"></span>
                        <span class="text-muted small fw-semibold d-block">10:30 am</span>
                        <span class="text-dark fw-bold">Tu pedido fue despachado</span>
                    </div>

                    <div class="timeline-step mb-4 position-relative">
                        <span class="position-absolute bg-dark rounded-circle" style="width: 12px; height: 12px; left: -25px; top: 4px;"></span>
                        <span class="text-muted small fw-semibold d-block">13:00 pm</span>
                        <span class="text-dark fw-bold">En centro de distribución local</span>
                    </div>

                    <div class="timeline-step position-relative">
                        <span class="position-absolute bg-secondary rounded-circle" style="width: 12px; height: 12px; left: -25px; top: 4px;"></span>
                        <span class="text-muted small fw-semibold d-block">16:30 pm</span>
                        <span class="text-muted fw-bold">Horario aproximado de entrega</span>
                    </div>
                </div>
            }

        </div>

    </div>
</div>