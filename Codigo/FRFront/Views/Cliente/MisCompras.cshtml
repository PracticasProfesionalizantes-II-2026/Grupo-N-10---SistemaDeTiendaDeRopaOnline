@model List<FRFront.Models.PedidoModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mis Compras";
}

<div class="container my-5" style="max-width: 800px;">
    
    <!-- Encabezado / Volver -->
    <div class="mb-4 pb-3 border-bottom">
        <a asp-controller="Home" asp-action="Index" class="text-dark fw-bold text-uppercase text-decoration-none small" style="letter-spacing: 1px;">
            &lt; VOLVER
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        
        <h2 class="fw-bold text-uppercase mb-4" style="letter-spacing: 1.5px; font-size: 1.4rem;">MIS COMPRAS</h2>

        @if (Model != null && Model.Any())
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var pedido in Model)
                {
                    <div class="card border rounded-4 p-3 p-md-4 shadow-sm bg-light position-relative">
                        <div class="row align-items-center g-3">
                            
                            <!-- Imagen del producto comprado -->
                            <div class="col-4 col-md-2 text-center">
                                <div class="bg-white rounded-3 p-2 border shadow-sm mx-auto" style="width: 85px; height: 95px; display: flex; align-items: center; justify-content: center;">
                                    <img src="@Url.Content(pedido.ImagenProducto)" alt="Producto" class="img-fluid h-100 w-100 object-fit-contain" />
                                </div>
                            </div>

                            <!-- Información del Estado y Fechas -->
                            <div class="col-8 col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold @(pedido.Estado == "Entregado" ? "text-success" : "text-success")" style="font-size: 0.95rem;">
                                        @pedido.Estado
                                    </span>
                                    <span class="text-muted small">(@pedido.NroPedido)</span>
                                </div>
                                <p class="text-dark fw-semibold mb-1 small" style="font-size: 0.9rem;">
                                    @pedido.DetalleFecha
                                </p>
                                <p class="text-secondary small m-0">
                                    @pedido.TotalProductos @(pedido.TotalProductos == 1 ? "producto" : "productos")
                                </p>
                            </div>

                            <!-- Botones de Acción (Volver a comprar / Seguir envío) -->
                            <div class="col-12 col-md-4 text-md-end d-flex flex-column align-items-md-end align-items-start gap-2 pt-2 pt-md-0 border-top border-md-0">
                                <a asp-controller="Home" asp-action="Catalogo" class="text-primary text-decoration-none fw-semibold small" style="font-size: 0.85rem;">
                                    volver a comprar
                                </a>

                                @if (pedido.Estado != "Entregado")
                                {
                                    <a href="#" class="text-dark text-decoration-none fw-bold small" style="font-size: 0.85rem;">
                                        Seguir Envío
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted mb-4">Aún no realizaste ninguna compra.</p>
                <a asp-controller="Home" asp-action="Catalogo" class="btn btn-primary rounded-pill px-5 py-3 text-uppercase fw-bold shadow-sm" style="background-color: #4b6bfb; border: none; letter-spacing: 1.5px;">
                    Ir al Catálogo &rarr;
                </a>
            </div>
        }

    </div>
</div>