@model List<FRFront.Models.PedidoModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mis Compras";
}

<div class="container my-5" style="max-width: 900px;">
    
    <!-- Botón Volver -->
    <a asp-controller="Home" asp-action="Index" class="text-dark fw-bold text-uppercase text-decoration-none small mb-4 d-inline-block" style="letter-spacing: 1px;">
        &lt; Volver
    </a>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h2 class="fw-bold text-uppercase mb-4" style="letter-spacing: 1.5px; font-size: 1.5rem;">Mis Compras</h2>

        @if (Model != null && Model.Any())
        {
            <div class="d-flex flex-column gap-4">
                @foreach (var pedido in Model)
                {
                    bool esEntregado = pedido.Estado.Equals("Entregado", StringComparison.OrdinalIgnoreCase);
                    string colorEstado = "text-success";

                    <div class="card border rounded-4 p-4 bg-white shadow-sm position-relative">
                        <div class="row align-items-center g-4">
                            
                            <!-- Miniaturas de los productos del pedido -->
                            <div class="col-md-3 text-center border-end">
                                @if (pedido.Productos != null && pedido.Productos.Any())
                                {
                                    <div class="d-flex flex-wrap justify-content-center gap-2 align-items-center" style="min-height: 90px;">
                                        @foreach (var prod in pedido.Productos)
                                        {
                                            <div class="bg-light p-2 rounded border position-relative" style="width: 75px; height: 75px;">
                                                <img src="@Url.Content(prod.Imagen)" alt="@prod.Nombre" class="img-fluid h-100 w-100 object-fit-contain" />
                                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark" style="font-size: 0.6rem;">
                                                    x@(prod.Cantidad)
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(pedido.ImagenProducto))
                                {
                                    <div class="bg-light p-2 rounded border position-relative mx-auto" style="width: 75px; height: 75px;">
                                        <img src="@Url.Content(pedido.ImagenProducto)" alt="Producto" class="img-fluid h-100 w-100 object-fit-contain" />
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark" style="font-size: 0.6rem;">
                                            x@(pedido.TotalProductos)
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-light p-2 rounded border d-flex align-items-center justify-content-center mx-auto" style="width: 75px; height: 75px;">
                                        <span class="text-muted small">Sin imagen</span>
                                    </div>
                                }
                            </div>

                            <!-- Información principal del pedido -->
                            <div class="col-md-9">
                                <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                                    <div>
                                        <h5 class="fw-bold m-0 @colorEstado fs-6">
                                            @pedido.Estado <span class="text-muted fw-normal">(@pedido.NroPedido)</span>
                                        </h5>
                                        <p class="text-secondary small mt-1 mb-0 fw-semibold">
                                            @pedido.DetalleFecha
                                        </p>
                                        <span class="text-muted" style="font-size: 0.75rem;">
                                            @(pedido.Productos?.Sum(p => p.Cantidad) ?? pedido.TotalProductos) producto(s)
                                        </span>
                                    </div>

                                    <!-- Acciones del pedido -->
                                    <div class="text-end">
                                        <a asp-controller="Home" asp-action="Catalogo" class="text-primary fw-bold text-decoration-none small d-block mb-1">
                                            Volver a comprar
                                        </a>
                                        @if (!esEntregado)
                                        {
                                            <a asp-controller="Cliente" asp-action="SeguirEnvio" asp-route-nroPedido="@pedido.NroPedido" class="text-dark fw-bold text-decoration-none small d-block">
                                                Seguir Envío
                                            </a>
                                        }
                                    </div>
                                </div>

                                <!-- Listado rápido de nombres y talles de productos -->
                                <div>
                                    @if (pedido.Productos != null && pedido.Productos.Any())
                                    {
                                        @foreach (var prod in pedido.Productos)
                                        {
                                            <div class="text-dark small fw-semibold">
                                                • @prod.Nombre <span class="text-muted">(Talle: @prod.Talle)</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted fs-5 mb-3">Aún no has realizado ninguna compra.</p>
                <a asp-controller="Home" asp-action="Catalogo" class="btn btn-dark rounded-pill px-4 py-2 text-uppercase fw-bold">
                    Ir al catálogo
                </a>
            </div>
        }
    </div>
</div>