@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pago Rechazado";
}

<div class="container my-5" style="max-width: 900px;">
    
    <!-- Encabezado de Volver -->
    <div class="mb-4 pb-2 border-bottom">
        <a asp-controller="Checkout" asp-action="Pago" class="text-dark fw-bold text-uppercase text-decoration-none small" style="letter-spacing: 1px;">
            &lt; VOLVER
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 p-md-5 text-center">
        
        <!-- Franja o recuadro Rojo de Rechazo -->
        <div class="p-5 rounded-4 text-white mb-4 shadow-sm" style="background-color: #d32f2f;">
            <div class="bg-white rounded-4 p-4 text-dark mx-auto shadow" style="max-width: 500px;">
                <h3 class="fw-bold text-danger mb-2" style="font-size: 1.6rem; letter-spacing: 0.5px;">Tu pago ha sido rechazado</h3>
                <p class="text-muted small mb-4">por favor vuélvelo a intentar</p>
                
                <!-- Icono de X en círculo -->
                <div class="rounded-circle border border-danger text-danger d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 70px; height: 70px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Mensaje de asesoramiento -->
        <p class="text-secondary mb-4 mx-auto" style="max-width: 600px; font-size: 0.95rem; line-height: 1.6;">
            No te preocupes, podés volverlo a intentar con un método de pago diferente, consultar con tu banco o intentarlo nuevamente más tarde.
        </p>

        <!-- Botón Reintentar -->
        <div>
            <a asp-controller="Checkout" asp-action="Pago" class="btn btn-primary rounded-pill px-5 py-3 text-uppercase fw-bold shadow-sm" style="background-color: #4b6bfb; border: none; letter-spacing: 1.5px;">
                Reintentar Pago
            </a>
        </div>

    </div>
</div>