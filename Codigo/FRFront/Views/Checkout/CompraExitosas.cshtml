@model List<FRFront.Models.ItemCarrito>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Compra Realizada";
    var nroPedido = ViewData["NroPedido"] ?? "#48192";

    // Cálculo dinámico de fechas de entrega (ej. entre 3 y 6 días a partir de hoy)
    var fechaInicio = DateTime.Now.AddDays(3);
    var fechaFin = DateTime.Now.AddDays(6);
    
    // Nombres de meses y días en español
    string[] meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre" };
    string[] diasSemana = { "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado" };

    string diaInicioStr = diasSemana[(int)fechaInicio.DayOfWeek];
    string diaFinStr = diasSemana[(int)fechaFin.DayOfWeek];
    string fechaTexto = $"{diaInicioStr} {fechaInicio.Day} y el {diaFinStr} {fechaFin.Day} de {meses[fechaInicio.Month - 1]}";
}

<div class="container my-5" style="max-width: 900px;">
    
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        
        <!-- Franja Verde de Éxito -->
        <div class="p-5 text-white text-center" style="background-color: #2ecc71;">
            <h1 class="fw-bold mb-4" style="font-size: 2.2rem; letter-spacing: 1px;">¡Tu compra ha sido exitosa!</h1>
            
            <div class="row align-items-center justify-content-center g-4 mt-2">
                
                <!-- Carrusel o Galería de Productos Comprados -->
                <div class="col-md-5 text-center">
                    <div class="d-flex flex-wrap gap-2 justify-content-center align-items-center bg-white rounded-4 p-3 shadow-sm mx-auto" style="max-width: 320px; min-height: 200px;">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <div class="position-relative" style="width: 80px; height: 90px;">
                                    <img src="@Url.Content(item.Imagen)" alt="@item.Nombre" class="img-fluid h-100 w-100 object-fit-contain rounded border bg-light" />
                                    @if (item.Cantidad > 1)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark" style="font-size: 0.6rem;">
                                            x@item.Cantidad
                                        </span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Imagen por defecto si la sesión expiró -->
                            <div style="width: 100px; height: 110px;">
                                <img src="~/images/buzovcv.png" alt="Producto" class="img-fluid h-100 w-100 object-fit-contain rounded" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Detalles dinámicos del envío y pedido -->
                <div class="col-md-7 text-md-start">
                    <p class="fs-5 mb-3 lh-sm">Tu producto llegará entre el <strong>@fechaTexto</strong></p>
                    <p class="fw-bold fs-5 m-0 text-uppercase" style="letter-spacing: 1px;">Nº PEDIDO: @nroPedido</p>
                </div>

            </div>
        </div>

        <!-- Botones inferiores de navegación -->
        <div class="p-4 bg-light d-flex flex-wrap justify-content-center align-items-center gap-3 gap-md-5">
            <a asp-controller="Cliente" asp-action="MisCompras" class="text-dark fw-bold text-uppercase text-decoration-none small">
                Ir a Mis Compras
            </a>
            <a href="#" class="text-dark fw-bold text-uppercase text-decoration-none small">
                Seguir Envío
            </a>
            <a asp-controller="Home" asp-action="Catalogo" class="btn btn-primary rounded-pill px-5 py-3 text-uppercase fw-bold shadow-sm" style="background-color: #4b6bfb; border: none; letter-spacing: 1.5px;">
                Seguir Comprando
            </a>
        </div>

    </div>
</div>